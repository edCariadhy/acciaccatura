{
  "name": "acciaccatura",
  "displayName": "Acciaccatura",
  "description": "Leave AI-readable annotations on code; agents read them over MCP.",
  "version": "0.0.1",
  "license": "MIT",
  "publisher": "acciaccatura",
  "icon": "media/icon.png",
  "keywords": [
    "annotations",
    "mcp",
    "agent",
    "ai",
    "code review"
  ],
  "galleryBanner": {
    "color": "#0d1117",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/edCariadhy/acciaccatura.git",
    "directory": "packages/extension"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "acciaccatura.annotateSelection",
        "title": "Acciaccatura: Annotate Selection"
      },
      {
        "command": "acciaccatura.refreshTree",
        "title": "Refresh Annotations",
        "icon": "$(refresh)"
      },
      {
        "command": "acciaccatura.deleteAnnotation",
        "title": "Delete Annotation"
      },
      {
        "command": "acciaccatura.reviewAnnotation",
        "title": "Promote to Authoritative"
      },
      {
        "command": "acciaccatura.resolveAnnotation",
        "title": "Mark Done",
        "category": "Acciaccatura"
      },
      {
        "command": "acciaccatura.reopenAnnotation",
        "title": "Reopen",
        "category": "Acciaccatura"
      },
      {
        "command": "acciaccatura.clearFinishedAnnotations",
        "title": "Delete Finished Notes",
        "category": "Acciaccatura",
        "icon": "$(clear-all)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "acciaccatura",
          "title": "Acciaccatura",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "acciaccatura": [
        {
          "id": "acciaccatura.annotations",
          "name": "Annotations"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "acciaccatura.deleteAnnotation",
          "when": "false"
        },
        {
          "command": "acciaccatura.reviewAnnotation",
          "when": "false"
        },
        {
          "command": "acciaccatura.refreshTree",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "acciaccatura.refreshTree",
          "when": "view == acciaccatura.annotations",
          "group": "navigation"
        },
        {
          "command": "acciaccatura.clearFinishedAnnotations",
          "when": "view == acciaccatura.annotations",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "acciaccatura.deleteAnnotation",
          "when": "view == acciaccatura.annotations"
        },
        {
          "command": "acciaccatura.reviewAnnotation",
          "when": "view == acciaccatura.annotations && viewItem == suggested"
        },
        {
          "command": "acciaccatura.resolveAnnotation",
          "when": "view == acciaccatura.annotations && viewItem =~ /^(suggested|authoritative)$/"
        },
        {
          "command": "acciaccatura.reopenAnnotation",
          "when": "view == acciaccatura.annotations && viewItem == resolved"
        }
      ]
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=out/extension.js --format=cjs --platform=node --target=node18 --external:vscode --sourcemap",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "vscode-test",
    "pretest:e2e": "npm run build",
    "package": "vsce package --no-dependencies",
    "prepackage": "npm run build",
    "clean": "rm -rf out"
  },
  "devDependencies": {
    "@acciaccatura/core": "*",
    "@types/mocha": "^10.0.7",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  }
}
