{
  "name": "acciaccatura",
  "version": "0.0.0",
  "private": true,
  "description": "AI-readable code annotations for VS Code, delivered to any agent over MCP.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "docs:check": "node scripts/docs-check.mjs docs",
    "clean": "npm run clean --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "SEE LICENSE IN packages/*",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "globals": "^15.9.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.2.0"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "diff": "^8.0.3"
  }
}
