node_modules/
dist/
out/
*.vsix
*.tsbuildinfo
coverage/
.DS_Store
.vscode-test/

# Mutation testing output: a fresh report every run, and Stryker's sandbox.
reports/
.stryker-tmp/

# Ignore personal editor state, but keep the shared run configs that make
# F5 "Run Extension" work for everyone.
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json

# Stores our own dev builds write into this workspace while testing. This is a
# development artefact, NOT the product's default: Acciaccatura ships no
# .gitignore, so in a user's repository .acciaccatura/ is committed unless they
# choose otherwise. See docs/wiki/standards/storage-and-lifecycle.md.
.acciaccatura/
